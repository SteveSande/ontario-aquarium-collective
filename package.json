{
  "name": "ontario-aquarium-collective",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "api",
    "app"
  ],
  "scripts": {
    "dev:api": "cd api && ../node_modules/.bin/nodemon -x ../node_modules/.bin/ts-node src/index.ts",
    "dev:app": "cd app && ../node_modules/.bin/astro dev",
    "build": "cd app && ../node_modules/.bin/astro build",
    "test": "cd api && ../node_modules/.bin/cross-env NODE_ENV=test npm run migrate && npm run mocha"
  }
}
