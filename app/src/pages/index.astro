---
import Layout from "../layouts/Layout.astro";
import styles from "./index.module.css";
import CategoryTile from "../components/CategoryTile.astro";
---

<Layout>
    <h1>Ontario Aquarium Collective</h1>
    <ul class={styles.categoryList}>
        <CategoryTile
            label="Saltwater Livestock"
            emojis="🪸🐡"
            href="/saltwater-livestock"
        />
        <CategoryTile
            label="Freshwater Livestock"
            emojis="🌿🐟"
            href="/freshwater-livestock"
        />
        <CategoryTile label="Supplies" emojis="📦" href="/supplies" />
        <CategoryTile label="Houseplants" emojis="🪴" href="/houseplants" />
    </ul>
</Layout>
