---
import Layout from "../layouts/Layout.astro";
import styles from "./index.module.css";
import CategoryTile from "../components/CategoryTile.astro";
---

<Layout h1="Ontario Aquarium Collective">
    <ul class={styles.categoryList}>
        <CategoryTile
            label="Saltwater Livestock"
            emojis="🪸🐡"
            href="/listings?category=saltwater"
        />
        <CategoryTile
            label="Freshwater Livestock"
            emojis="🌿🐟"
            href="/listings?category=freshwater"
        />
        <CategoryTile
            label="Supplies"
            emojis="📦"
            href="/listings?category=supplies"
        />
        <CategoryTile
            label="Houseplants"
            emojis="🪴"
            href="/listings?category=houseplants"
        />
    </ul>
</Layout>
