        <Logo width="100" height="100" />
    </a>
    <nav class={styles.nav} aria-label="Primary navigation">
        <NavTile label="Home" href="/" />
        <NavTile label="About" href="/about/" />
        <NavTile label="Login" href="/login/" />
    </nav>
</header>
